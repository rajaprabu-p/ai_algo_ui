# sample.env - template for committing to repo
# Copy to .env and fill values locally. DO NOT commit real secrets.

# API credentials
API_KEY=REPLACE_WITH_API_KEY
API_SECRET=REPLACE_WITH_API_SECRET

# Tokens
ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN

# Login: do not write a password here. Run `python scripts/set_login_password.py`,
# which stores only a password hash and a random session key in .env.
LOGIN_USERNAME=your.email@example.com
LOGIN_PASSWORD_HASH=
APP_SECRET_KEY=

# Persistent strategy log directory (set this on Azure/Vultr, for example:
# /home/rpalgo_logs). The default is the repository's logs/ directory.
STRATEGY_LOG_DIR=
